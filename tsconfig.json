{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/sanity",
    "src/cms",
    "src/data/sanityData.ts",
    "src/data/sanityRemote.ts",
    "src/data/localFallback.ts",
    "src/data/cache.ts",
    "src/data/types.ts",
    "src/data/hooks.ts",
    "sanity.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/data/*.js", "src/components", "src/hooks"]
}
