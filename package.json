{
  "name": "lizongheng-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:site": "node ./node_modules/vite/bin/vite.js build --mode site-only",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "studio": "node ./node_modules/sanity/bin/sanity dev",
    "studio:build": "node ./node_modules/sanity/bin/sanity build",
    "studio:deploy": "node ./node_modules/sanity/bin/sanity deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "groq": "^6.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  }
}
